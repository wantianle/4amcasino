{
  "name": "4amcasino",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.0.0" },
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "test": "vitest run",
    "test:fast": "vitest run --exclude '**/evalInfra.test.mjs' --exclude '**/node_modules/**' --exclude '**/dist/**' --exclude '.slim/**'",
    "test:bench": "RUN_BENCH=1 vitest run packages/agent-core/test/postflopPolicy.test.ts",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "prettier": "^3.3.0",
    "@types/node": "^22.0.0"
  }
}
