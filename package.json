{
  "name": "4amcasino",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.0.0" },
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "test": "vitest run",
    "test:fast": "vitest run --exclude '**/evalInfra.test.mjs' --exclude '**/node_modules/**' --exclude '**/dist/**' --exclude '.slim/**'",
    "test:server": "vitest run apps/server/test --exclude '**/evalInfra.test.mjs'",
    "test:core": "vitest run packages/agent-core/test",
    "test:bench": "RUN_BENCH=1 vitest run packages/agent-core/test/postflopPolicy.test.ts",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build:all",
    "build:web": "npm run build:web -w @4am/web",
    "build:server": "npm run build -w @4am/server",
    "build:all": "npm run build:web && npm run build:server",
    "check:diff": "node scripts/check-diff.mjs",
    "check:tracked": "node scripts/check-tracked.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:clean-tree": "node scripts/check-clean-tree.mjs",
    "check:build": "node scripts/check-build.mjs",
    "check:all": "npm run check:diff && npm run check:tracked && npm run check:links && npm run check:clean-tree && npm run check:build",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "prettier": "^3.3.0",
    "@types/node": "^22.0.0"
  }
}
