# Copy to .env and fill in. 32 bytes as 64 hex chars.
BOT_IDENTITY_KEY=

# ── Runtime tunables ─────────────────────────────────────────────────────────
#
# Every value below is read from the environment at STARTUP: `apps/server/scripts/start.mjs`
# loads this repo-root `.env` via `process.loadEnvFile`. Change a value, restart
# the server, and it takes effect — NO rebuild of the server or the web app.
# The web client fetches the public timings from `GET /api/config` when it loads,
# so frontend animation durations are restart-configurable too.
#
# Unset / empty / non-numeric / out-of-range values fall back to the default
# shown. All durations are in milliseconds.

# --- Server self-use (never sent to clients) ---
# Bot think-delay buffer, a uniform draw in [min, max]. Non-negative integers,
# no practical upper bound (the wait is capped against the action clock).
BOT_THINK_MIN_MS=150
BOT_THINK_MAX_MS=450
# Hard upper bound on a graceful bot stop. Positive integer, up to the
# setTimeout ceiling (~24.8 days); 0/negative/NaN falls back to the default.
FOURAM_BOT_HARD_STOP_MS=120000
# Auto-deal cadence after a hand settles, and the ready-check consent window.
# Positive integers (ms); a showdown's settle hold can still extend the cadence.
FOURAM_AUTO_DEAL_INTERVAL_MS=3500
FOURAM_AUTO_DEAL_READY_CHECK_MS=1500

# --- Published to the web client via GET /api/config ---
# Ready-seat breathing pulse. Range 0..10000. (CSS --table-dur-pulse)
TABLE_DUR_PULSE_MS=1600
# Acting-seat glow entrance. Range 0..10000. (CSS --table-dur-glow)
TABLE_DUR_GLOW_MS=450
# Fold / leave / lost dimming. Range 0..10000. (CSS --table-dur-dim)
TABLE_DUR_DIM_MS=460
# Winner-highlight fade-in. Range 0..10000. (CSS --table-dur-highlight)
TABLE_DUR_HIGHLIGHT_MS=620
# How long the win celebration stays lit. Range 0..60000. (CSS --win-fx-ms)
WIN_FX_MS=3000
# Delay before the winner's stack number reveals. Range 0..60000. (CSS --stack-land-ms)
STACK_LAND_MS=910
